<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass requests to /api/ directly to the PHP API backend
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]

  # Allow direct access to existing files and folders
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite all other paths to index.html for client-side SPA routing
  RewriteRule ^ index.html [L]
</IfModule>

Options -Indexes
